# Copy this file to .env and keep the real .env local.
# Never commit tokens, credentials, chat IDs, user IDs, or local auth files.

ASSISTANT_NAME=Skoobi
RUNTIME=sandbox
# Managed installers replace this with com.skoobi.<instance>.
SKOOBI_SERVICE_LABEL=com.skoobi.default

# Telegram
TELEGRAM_BOT_TOKEN=
SKOOBI_TELEGRAM_BOT_ID=telegram_default
OWNER_TELEGRAM_USER_IDS=
# Optional public contact shown in onboarding, for example @your_bot_admin.
SKOOBI_ADMIN_CONTACT=
SKOOBI_TELEGRAM_GUEST_LIVE_ENABLED=false
SKOOBI_TELEGRAM_OWNER_LIVE_ENABLED=false

# Codex CLI provider. Authenticate with the official `codex login` command.
# Skoobi must not read or copy Codex credential files.
SKOOBI_MODEL_GATEWAY_TYPE=codex_subscription_cli
SKOOBI_CODEX_SUBSCRIPTION_ENABLED=true
SKOOBI_CODEX_MODEL=
SKOOBI_CODEX_FALLBACK_MODEL=
SKOOBI_CODEX_ALLOW_MODEL_DOWNGRADE=false
SKOOBI_CODEX_REASONING_EFFORT=high
SKOOBI_CODEX_WEB_SEARCH_ENABLED=false
SKOOBI_CLAUDE_FALLBACK_ENABLED=false

# Optional local voice transcription and speech.
TTS_PROVIDER=local
# WHISPER_BIN=<PATH_TO_WHISPER_CLI>
# WHISPER_MODEL=<PATH_TO_LOCAL_MODEL>

# Optional WhatsApp personal observer. It is disabled by default.
SKOOBI_WHATSAPP_CHANNEL_ENABLED=false
SKOOBI_WHATSAPP_PERSONAL_OBSERVER_ENABLED=false
ASSISTANT_HAS_OWN_NUMBER=false

# Optional Google Workspace broker. Keep OAuth material outside the repository.
SKOOBI_GOOGLE_WORKSPACE_ENABLED=false
# SKOOBI_GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=<CLIENT_ID>
# SKOOBI_GOOGLE_WORKSPACE_OAUTH_CLIENT_SECRET=<SECRET>
# SKOOBI_GOOGLE_WORKSPACE_REFRESH_TOKEN_FILE=<PATH_OUTSIDE_REPOSITORY>
# SKOOBI_GOOGLE_WORKSPACE_ALLOWED_RESOURCE_IDS=<RESOURCE_IDS>
# Optional migration-only dashboard fallback. The file must be a regular file
# inside STATE_ROOT; parent symlinks, traversal and outside paths are rejected.
# SKOOBI_GOOGLE_WORKSPACE_LEGACY_CRM_TOPIC_FILE=data/legacy-crm-topic.md

# Optional Google Calendar reminders. A valid ID is required even when a local
# service-account key exists. Use "primary" only as an explicit owner choice.
SKOOBI_GOOGLE_CALENDAR_ENABLED=false
# SKOOBI_GOOGLE_CALENDAR_ID=primary
# SKOOBI_GOOGLE_CALENDAR_KEY_FILE=<PATH_OUTSIDE_REPOSITORY>

# Optional local Codex Desktop bridge. Use a random local secret and allow only
# dedicated worktrees that do not contain credentials or production state.
# HELPER_SECRET=<RANDOM_LOCAL_SECRET>
# CODEX_DESKTOP_OWNER_CHAT_JID=<OWNER_CHAT_ID>
# CODEX_DESKTOP_ALLOWED_ROOTS=<SAFE_WORKTREE_PATHS>

# Optional webhook. Keep it bound to localhost unless it is placed behind an
# authenticated reverse proxy.
# WEBHOOK_HOST=127.0.0.1
# WEBHOOK_PORT=3100
# WEBHOOK_SECRET=<RANDOM_LOCAL_SECRET>

# Billing, payment integrations, guest rollout, and owner tools are fail-closed
# by default. Enable them only after reviewing their policy and tests.
SKOOBI_BILLING_ENABLED=false
# No network payment adapter or paid catalog is bundled. Enabling payments
# requires registering a reviewed provider adapter and supplying a validated
# JSON catalog in the host application.
SKOOBI_PAYMENT_ENABLED=false
SKOOBI_PAYMENT_PROVIDER=
SKOOBI_PAYMENT_CURRENCY=USD
# SKOOBI_PAYMENT_CATALOG_JSON=[]
SKOOBI_PRIVATE_ADMIN_MODE=false

# Optional retention summary delivery. When unset, retention never sends a
# Telegram report automatically.
# SKOOBI_RETENTION_REPORT_CHAT_ID=<OWNER_CHAT_ID>
