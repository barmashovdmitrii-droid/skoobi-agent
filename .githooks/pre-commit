#!/bin/bash
# Pre-commit hook: Block commits containing secrets or project-specific identifiers
# Patterns to catch: passwords, connection strings, API keys, internal hostnames

set -uo pipefail
umask 077
# Paths and staged content are matched byte by byte: in a UTF-8 locale a file
# name that is not valid UTF-8 would make the path rules below miss.
export LC_ALL=C

PATTERNS=(
  'xoxb-[0-9]'           # Slack bot tokens
  'xapp-[0-9]'           # Slack app tokens
  'sk-''ant-'            # Anthropic API keys
  'sk-[a-zA-Z0-9]{20,}'  # Generic API keys
  'gh[pousr]_[a-zA-Z0-9]{20,}' # GitHub tokens
  'github_pat_[a-zA-Z0-9_]{20,}' # GitHub fine-grained tokens
  '-----BEGIN (ENCRYPTED |RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----'
  'password.*=.*[a-f0-9]{16,}'  # Passwords in assignments
  'https?://[^/[:space:]:@]+:[^@[:space:]/]+@' # URLs with credentials
  '://[^@]+:[^@]+@[^/]+\.(net|com|io|dev|app)' # Connection strings with credentials
  'proxy\.rlwy\.net'     # Railway proxy hosts
)

# Tier 1 privacy: block paths that contain user data even if .gitignore is
# bypassed by an explicit `git add -f`.
BLOCKED_PATHS=(
  '(^|/)groups/'
  '(^|/)store/'
  '^backups/'
  '(^|/)logs/'
  '(^|/)data/ipc/'
  '(^|/)(received|output)/'
  '(^|/)(auth|credentials|secrets|sessions)/'
  '(^|/)\.env($|\.)'
  '(^|/)\.envrc($|\.)'
  '(^|/)[^/]+\.env($|\.)'
  '(^|/)\.(aws|claude|codex|docker|gnupg|kube|ssh)/'
  '(^|/)\.(git-credentials|netrc|npmrc|pypirc)$'
  '(^|/)[^/]*(application_default_credentials|auth|cookie|credential|secret|session|token)[^/]*\.json$'
  '(^|/)client_secret[^/]*\.json$'
  '(^|/)[^/]*service-account[^/]*\.json$'
  '(^|/)id_(rsa|ed25519)[^/]*$'
  '(^|/)[^/]+\.(pem|key|p12|pfx|log|bak|backup|zip|tar|tgz|7z|jsonl|ndjson)$'
  '(^|/)[^/]*\.(db|sqlite|sqlite3)(-(wal|shm|journal))?$'
)

# Tracked files whose names fall under the rules above although they hold no
# private data: the documented env template, the link through which agents
# find the bundled skills, and the synthetic corpora of the credential
# detector tests. Exact paths only (no patterns, no subtrees); the secret scan
# below still reads what is staged for them.
PATH_RULE_EXEMPT=(
  '.env.example'
  'public-release/overlay/.env.example'
  '.claude/skills'
  'packages/core/test-fixtures/memory-credential-corpus.json'
  'packages/core/test-fixtures/memory-credential-round0.json'
  'packages/core/test-fixtures/memory-credential-round1.json'
)

path_rule_exempt() {
  local exempt
  for exempt in "${PATH_RULE_EXEMPT[@]}"; do
    [ "$1" = "$exempt" ] && return 0
  done
  return 1
}

# A path is printed as it is (spaces, quotes and non-ASCII letters stay
# readable) minus control characters, so a file name cannot rewrite the
# terminal output.
printable_path() {
  printf '%s' "$1" | tr -d '\000-\037\177'
}

# A rule is tried against the whole path and against each of its lines: `^` and
# `$` anchor only at the ends of the string, so a name with a line break in it
# (".env" or "copy.db" followed by a newline) would otherwise pass the rules.
path_matches() {
  local rest="$1" rule="$2" line
  [[ "$rest" =~ $rule ]] && return 0
  case "$rest" in
    *$'\n'*) ;;
    *) return 1 ;;
  esac
  while :; do
    line="${rest%%$'\n'*}"
    [[ "$line" =~ $rule ]] && return 0
    [ "$line" = "$rest" ] && return 1
    rest="${rest#*$'\n'}"
  done
}

TEMP_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/skoobi-precommit.XXXXXX")" || {
  echo "Commit blocked: cannot create a private temporary directory."
  exit 1
}
trap 'rm -rf -- "$TEMP_ROOT"' EXIT HUP INT TERM
STAGED_LIST="$TEMP_ROOT/staged-paths"
PATCH_FILE="$TEMP_ROOT/staged.patch"

# R: a `git mv` into backups/ or to *.db must not slip past the path and
# secret checks (--name-only prints the new path of a rename).
# Review r1111 (security-3): plain --name-only quotes a path with non-ASCII
# characters ("backups/\320\276….md"), and the quotes broke every ^/$ check;
# -z gives raw NUL-separated paths. Read into an array without a pipe (the
# loop must not run in a subshell) and without mapfile (bash 3.2 on macOS).
if ! git --no-pager diff --cached --name-only --diff-filter=ACMRT -z \
  >"$STAGED_LIST"; then
  echo "Commit blocked: cannot inspect staged paths."
  exit 1
fi

STAGED_FILES=()
while IFS= read -r -d '' file; do
  STAGED_FILES+=("$file")
done <"$STAGED_LIST"

[ "${#STAGED_FILES[@]}" -eq 0 ] && exit 0

# Reject staged paths under privacy-sensitive trees.
PATH_BLOCKED=0
for file in "${STAGED_FILES[@]}"; do
  # .env.example is documentation and must stay commit-able, but every real
  # env file remains blocked by the patterns below. The same goes for the
  # other exact paths of PATH_RULE_EXEMPT.
  if path_rule_exempt "$file"; then
    continue
  fi
  for blocked in "${BLOCKED_PATHS[@]}"; do
    if path_matches "$file" "$blocked"; then
      printf 'BLOCKED: %s matches privacy-sensitive path pattern (%s).\n' \
        "$(printable_path "$file")" "$blocked"
      PATH_BLOCKED=1
    fi
  done
done

if [ $PATH_BLOCKED -ne 0 ]; then
  echo "================================================================"
  echo "Commit blocked: privacy-sensitive paths cannot be checked in."
  echo "These paths hold per-user data (groups/), databases (*.db*),"
  echo "backups/, logs, env files, credentials and keys, or local IPC sockets."
  echo "================================================================"
  exit 1
fi

FOUND=0
for file in "${STAGED_FILES[@]}"; do
  # Skip binary files. Other image types stay scanned, as they always were:
  # Git prints no added lines for real binary content, and a text file that
  # only carries an image extension must not hide a secret.
  case "$file" in
    *.png|*.jpg|*.ico)
      continue
      ;;
  esac

  if ! git --no-pager --literal-pathspecs diff --cached --no-ext-diff \
    --no-textconv -- "$file" >"$PATCH_FILE"; then
    printf 'Commit blocked: cannot inspect staged content for %s.\n' \
      "$(printable_path "$file")"
    exit 1
  fi

  for pattern in "${PATTERNS[@]}"; do
    # Only the file and the rule are named: the matched lines hold the secret
    # and must not reach the terminal or a CI log.
    if grep -qE "^\+.*$pattern" "$PATCH_FILE"; then
      printf '❌ BLOCKED: Potential secret in %s matching pattern: %s\n' \
        "$(printable_path "$file")" "$pattern"
      FOUND=1
    else
      grep_status=$?
      if [ "$grep_status" -ne 1 ]; then
        echo "Commit blocked: secret scan failed."
        exit 1
      fi
    fi
  done
done

if [ $FOUND -ne 0 ]; then
  echo "================================================================"
  echo "Commit blocked: potential secrets detected in staged files."
  echo "Move secrets to .env and use env var references instead."
  echo "To bypass (if false positive): git commit --no-verify"
  echo "================================================================"
  exit 1
fi

exit 0
